Thumbs.db
.DS_Store

# Raw source pictures before conversion -- local staging only, never
# uploaded. images/ (the converted .tga/.blp output) ships instead.
/images-src/*.png
/images-src/*.jpg
/images-src/*.jpeg
/images-src/*.bmp
/images-src/*.gif
/images-src/*.webp

# Same idea for UI chrome assets (e.g. the logo) -- textures/ (the
# converted .tga output) ships instead.
/textures-src/*.png
/textures-src/*.jpg
/textures-src/*.jpeg
/textures-src/*.bmp
/textures-src/*.gif
/textures-src/*.webp
